{
  "name": "khalid-pharmacy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:pricing": "node --experimental-strip-types scripts/test-smart-pricing.ts",
    "test:units": "node --experimental-strip-types scripts/test-medicine-unit-policy.ts",
    "test:phase2a": "npm run test:pricing && npm run test:units",
    "test:inventory-cost": "node --experimental-strip-types scripts/test-inventory-cost-policy.ts",
    "test:phase2b": "npm run test:pricing && npm run test:inventory-cost && npm run test:stock-policy",
    "test:stock-policy": "node --experimental-strip-types scripts/test-inventory-stock-policy.ts",
    "test:medicine-recognition": "node --experimental-strip-types scripts/test-medicine-text-parser.ts",
    "test:web-ocr-offline": "node scripts/test-web-ocr-offline.mjs",
    "test:ocr-tesseract": "npx tsx scripts/test-ocr-tesseract-integration.ts",
    "test:batch-capture": "npx tsx scripts/test-batch-capture.ts",
    "test:batch-capture-2": "npx tsx scripts/test-batch-capture-2.ts",
    "test:single-image-ocr": "npx tsx scripts/test-single-image-multi-ocr.ts",
    "test:phase3-6b": "npm run test:batch-capture && npm run test:single-image-ocr",
    "test:bankak-phase-a": "npx tsx scripts/test-bankak-phase-a.ts",
    "prebuild": "node scripts/prepare-web-ocr-assets.mjs",
    "test:bankak-phase-b-persistence": "npx tsx scripts/test-bankak-phase-b-persistence.ts",
    "test:phase1a-local": "npx tsx scripts/test-phase1-local-persistence.ts",
    "test:phase1a-bankak-migration": "npx tsx scripts/test-phase1a-bankak-migration.ts",
    "test:phase1a": "npm run test:phase1a-local && npm run test:phase1a-bankak-migration && npm run test:bankak-phase-a",
    "test:backup-encryption": "npx tsx scripts/test-backup-encryption.ts",
    "test:backup-serializer": "npx tsx scripts/test-backup-serializer.ts",
    "test:restore-sandbox": "npx tsx scripts/test-restore-sandbox.ts",
    "test:google-drive-oauth": "npx tsx scripts/test-google-drive-oauth-service.ts && npx tsx scripts/test-google-drive-oauth-ui.ts",
    "test:google-drive-oauth-platform": "npx tsx scripts/test-google-drive-oauth-platform.ts",
    "test:phase-c": "npm run test:bankak-retention && npm run test:backup-encryption && npm run test:backup-serializer && npm run test:restore-sandbox && npm run test:google-drive-oauth && npm run test:google-drive-backup && npm run test:google-drive-oauth-platform",
    "test:google-drive-backup": "npx tsx scripts/test-google-drive-backup-service.ts",
    "test:bankak-retention": "npx tsx scripts/test-bankak-image-retention.ts",
    "test:error-logs": "node --experimental-strip-types scripts/test-error-log-service.ts",
    "test:multi-branch": "npx tsx scripts/test-multi-branch-security.ts",
    "test:pr2d-packing-lock": "npx tsx scripts/test-phase2d-pr2d-packing-lock-coordinator.ts",
    "test:phase2d-pr2c": "node --experimental-strip-types scripts/test-phase2d-pr2c-exact-costing-pricing.ts",
    "test:phase2e": "npx tsx scripts/test-phase2e-live-integration.ts && npm run test:units && npm run test:phase2d-pr2c && npm run test:pricing && npx tsx scripts/test-phase2d-3b2b3-pr2b-migration.ts"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "7.5.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@google/genai": "^2.32.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@zxing/library": "^0.23.0",
    "dotenv": "^17.2.3",
    "eslint": "^10.15.0",
    "express": "^4.21.2",
    "firebase": "^13.3.0",
    "html2canvas-pro": "^2.6.0",
    "jspdf": "^4.2.1",
    "lucide": "^1.65.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "vue": "^3.5.44",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
