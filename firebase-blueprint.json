          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "claimedUid": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "email", "displayName", "role", "branchIds", "active", "invitedByUid", "createdAt", "updatedAt"]
    },
