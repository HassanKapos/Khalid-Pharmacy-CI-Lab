  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Protected staff profiles mapping Firebase Auth UIDs to verified roles and assigned branch IDs."
    },
    "/staff_invites/{inviteId}": {
      "schema": { "$ref": "#/entities/StaffInvite" },
      "description": "Pre-authorized email invitations for staff onboarding without client-side privilege escalation."
    },
    "/branches/{branchId}": {
      "schema": { "$ref": "#/entities/PharmacyBranch" },
      "description": "Pharmacy branch metadata and bounded member/admin UID lists."
    },
    "/branches/{branchId}/medicines/{medicineId}": {
      "schema": { "$ref": "#/entities/BranchMedicine" },
      "description": "Branch-isolated medicine catalog and prices."
    },
    "/branches/{branchId}/inventory_ledger/{movementId}": {
      "schema": { "$ref": "#/entities/BranchInventoryLedger" },
      "description": "Append-only branch inventory movements."
    },
    "/branches/{branchId}/sales/{saleId}": {
      "schema": { "$ref": "#/entities/BranchSale" },
      "description": "Branch-isolated POS sales."
    },
    "/branches/{branchId}/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/BranchSupplier" },
      "description": "Branch-isolated suppliers."
    },
    "/branches/{branchId}/purchase_invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/BranchPurchaseInvoice" },
      "description": "Branch-isolated supplier purchase invoices."
    },
    "/branches/{branchId}/supplier_transactions/{txId}": {
      "schema": { "$ref": "#/entities/BranchSupplierTransaction" },
      "description": "Branch-isolated supplier payment and balance transactions."
    },
    "/branches/{branchId}/receipts/{receiptId}": {
      "schema": { "$ref": "#/entities/BranchReceipt" },
      "description": "Branch-isolated Bankak archive receipts."
    },
    "/branches/{branchId}/supplier_invoice_drafts/{draftId}": {
      "schema": { "$ref": "#/entities/BranchOcrDraft" },
      "description": "Branch-isolated supplier invoice OCR drafts."
    },
    "/branches/{branchId}/stocktaking_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/BranchStocktakingSession" },
      "description": "Branch-isolated stocktaking sessions."
    },
    "/branches/{branchId}/audit_logs/{eventId}": {
      "schema": { "$ref": "#/entities/BranchAuditLog" },
      "description": "Append-only branch audit events."
    }
  }
}
