        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "code", "nameAr", "nameEn", "active", "adminUids", "memberUids", "createdAt", "updatedAt"]
    },
