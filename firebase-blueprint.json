{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Verified pharmacy staff profile storing role and assigned branch IDs.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["super_admin", "admin", "cashier"]
        },
        "branchIds": {
          "type": "array",
          "description": "Assigned branch identifiers (bounded to 50 max)."
        },
        "activeBranchId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "role", "branchIds", "active", "createdAt", "updatedAt"]
    },
    "StaffInvite": {
