rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function sameTenant(tenantId) {
      return signedIn() && request.auth.token.tenantId == tenantId;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }
    function isOperator() {
      return signedIn() && request.auth.token.role == 'operator';
    }

    match /tenants/{tenantId}/operationalRecords/{recordId} {
      allow read: if sameTenant(tenantId);
      allow create, update: if sameTenant(tenantId) && isOperator()
        && !request.resource.data.keys().hasAny(['purchaseCost', 'profit', 'valuation']);
      allow delete: if false;
    }

    match /tenants/{tenantId}/sensitiveRecords/{recordId} {
      allow read, write: if sameTenant(tenantId) && isAdmin();
    }

    match /tenants/{tenantId}/leases/{leaseId} {
      allow read: if sameTenant(tenantId);
      allow create: if sameTenant(tenantId) && isOperator()
        && request.resource.data.version == 0
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.expiresAt > request.time;
      allow update: if sameTenant(tenantId) && isOperator()
        && request.resource.data.version == resource.data.version + 1
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.expiresAt > request.time;
      allow delete: if false;
    }

    match /tenants/{tenantId}/events/{eventId} {
      allow read: if sameTenant(tenantId);
      allow create: if sameTenant(tenantId) && isOperator()
        && !exists(/databases/$(database)/documents/tenants/$(tenantId)/events/$(eventId));
      allow update, delete: if false;
    }
  }
}
